# Go API (task 002-13). Frontend VITE_* values belong in frontend/.env.example
# and frontend/.env.local. Environment names are exact: Local, Preview,
# Staging or Production. A missing CROWNPILOT_ENVIRONMENT stops the process
# before it listens; the other keys fall back to per-environment defaults.
CROWNPILOT_ENVIRONMENT="Local"
# PORT="5080"
# CROWNPILOT_CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# CROWNPILOT_OPENAPI_EXPOSE_JSON="true"
# CROWNPILOT_OPENAPI_EXPOSE_UI="true"
# CROWNPILOT_AUTH_CONTRACT_FIXTURES="true" # Local only; rejected elsewhere

# .NET baseline and db:* scripts until the 002-15 cutover.
ASPNETCORE_ENVIRONMENT="Development"
CROWNPILOT__ENVIRONMENT="Local"
CROWNPILOT__CORS__ALLOWEDORIGINS__0="http://localhost:5173"
CROWNPILOT__CORS__ALLOWEDORIGINS__1="http://127.0.0.1:5173"
CROWNPILOT__AUTHENTICATION__MODE="ContractFixture"
CROWNPILOT__AUTHENTICATION__CONTRACTFIXTURESENABLED="true"

# Server-only values are supplied by local secret storage or hosting runtime
# in later tasks. Do not commit values or copy production settings to Preview.
# Staging/Production real bearer authentication uses these server-side values;
# Google Application Default Credentials are preferred for the service account.
# CROWNPILOT__AUTHENTICATION__MODE="Firebase"
# CROWNPILOT__AUTHENTICATION__CONTRACTFIXTURESENABLED="false"
# CROWNPILOT__AUTHENTICATION__FIREBASE__PROJECTID=""
# CROWNPILOT__AUTHENTICATION__FIREBASE__ISSUER="https://securetoken.google.com/<project-id>"
# CROWNPILOT__AUTHENTICATION__FIREBASE__SERVICEACCOUNTJSON=""
# CROWNPILOT__AUTHENTICATION__FIREBASE__SERVICEACCOUNTFILE=""
# Render alternative: configure all three as secret runtime environment variables.
# FIREBASE_ADMIN_PROJECT_ID=""
# FIREBASE_ADMIN_CLIENT_EMAIL=""
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# Local db:* commands use database/docker-compose.yml and derive this disposable
# connection when the variable is absent. Staging and Production must inject
# different secret values at runtime; Preview must leave it unset.
# CROWNPILOT__DATABASE__CONNECTIONSTRING="Host=127.0.0.1;Port=54322;Database=crownpilot_local;Username=postgres;Password=postgres;SSL Mode=Disable"
# DATABASE_CONNECTION_STRING="" # legacy alias accepted only for local db:* commands
# CLASH_ROYALE_API_TOKEN=""
